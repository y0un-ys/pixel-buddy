{
  "manifest_version": 3,
  "name": "Pixel Buddy 영상 감지",
  "version": "1.0.0",
  "description": "실제 영상 재생 여부만 로컬 Pixel Buddy에 전달합니다.",
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pixel Buddy 영상 감지",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
